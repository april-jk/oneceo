{
  "name": "oneceo",
  "version": "0.1.0",
  "private": true,
  "description": "AI task execution and platform-governance workspace with a user cockpit, orchestration API, admin console, and E2B-based runtime flows",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm --filter web dev & pnpm --filter api dev",
    "dev:web": "pnpm --filter web dev",
    "dev:blog": "pnpm --filter blog dev",
    "dev:api": "pnpm --filter api dev",
    "dev:kvm": "pnpm --filter kvm-orchestrator dev",
    "build": "pnpm --filter @oneceo/shared build && pnpm --filter web build && pnpm --filter api build",
    "build:web": "pnpm --filter web build",
    "build:blog": "pnpm --filter blog build",
    "build:api": "pnpm --filter api build",
    "lint": "pnpm -r lint",
    "type-check": "pnpm -r type-check",
    "test": "pnpm -r test",
    "clean": "pnpm -r clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "typescript": "^5.6.3",
    "prettier": "^3.6.2",
    "eslint": "^9.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@10.4.1",
  "pnpm": {
    "overrides": {
      "dompurify": "3.4.2",
      "e2b>chalk": "4.1.2",
      "tailwindcss>nanoid": "3.3.7"
    }
  }
}
