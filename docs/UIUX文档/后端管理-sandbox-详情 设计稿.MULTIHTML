              "tertiary": "#7e5300",
              "on-error": "#ffffff",
              "secondary-container": "#316bf3",
              "primary-fixed-dim": "#6fd9be",
              "on-surface": "#0f1c2d",
              "on-background": "#0f1c2d"
            },
            fontFamily: {
              "headline": ["Inter"],
              "body": ["Inter"],
