{
  "name": "api",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && esbuild src/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test:opencode-direct": "tsx tests/opencode-sandbox-direct/run-direct-mode-tests.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.888.0",
    "@aws-sdk/lib-storage": "^3.888.0",
    "@aws-sdk/s3-request-presigner": "^3.1000.0",
    "@langchain/community": "^1.1.10",
    "@langchain/core": "^1.1.18",
    "@langchain/openai": "^1.2.4",
    "@oneceo/shared": "workspace:*",
    "@prisma/client": "^6.5.0",
    "@types/pg": "^8.16.0",
    "@types/ws": "^8.18.1",
    "bullmq": "^5.36.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "drizzle-kit": "^0.31.8",
    "drizzle-orm": "^0.45.1",
    "e2b": "^2.8.4",
    "express": "^4.21.2",
    "ioredis": "^5.4.2",
    "langchain": "^1.2.16",
    "pg": "^8.18.0",
    "socket.io": "^4.8.1",
    "undici": "^6.19.4",
    "ws": "^8.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^24.7.0",
    "esbuild": "^0.25.0",
    "prisma": "^6.5.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
