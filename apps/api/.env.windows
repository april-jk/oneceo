# OneCEO.ai API 环境配置文件 (Windows 版本)
# 请将此文件重命名为 .env 并放在 apps/api 目录下

# ============================================
# 数据库配置
# ============================================
# DATABASE_URL=postgresql://user:password@host:port/database

# ============================================
# 服务器配置
# ============================================
PORT=4000
FRONTEND_URL=http://localhost:3000

# ============================================
# OpenAI API 配置（使用自定义 Claude API）
# ============================================
OPENAI_API_KEY=sk-MRwNM2uHuQSWHohygTJQlWx0jR26xkf20gJJTp8NdRUDLO3c
OPENAI_BASE_URL=https://www.fucheers.top/v1
LLM_TIMEOUT_MS=90000
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_MS=800
LLM_RETRY_MAX_MS=4000

# ============================================
# 说明
# ============================================
# 1. 将此文件重命名为 .env
# 2. 确保文件位于 apps/api 目录下
# 3. 不要将 .env 文件提交到 Git（已在 .gitignore 中）
# 4. 如需修改配置，请编辑此文件后重启服务

# ============================================
# KVM 配置
# ============================================
KVM_ORCHESTRATOR_URL=http://192.168.10.172:8500
KVM_ORCH_TOKEN=replace_with_secure_token
KVM_SANDBOX_BASE_IMAGE=/var/lib/libvirt/images/base-images/ubuntu-22.04-base-v5.qcow2
KVM_SANDBOX_NETWORK=sandbox-net
KVM_SANDBOX_OS_VARIANT=ubuntu22.04
KVM_SANDBOX_MEMORY_MB=2048
KVM_SANDBOX_VCPUS=2
KVM_HTTP_TIMEOUT_MS=120000
KVM_HTTP_RETRIES=1
KVM_HTTP_TIMEOUT_HEALTH_MS=8000
KVM_HTTP_TIMEOUT_META_MS=15000
KVM_HTTP_TIMEOUT_SANDBOX_MS=30000
KVM_HTTP_TIMEOUT_JOB_MS=30000
KVM_HTTP_TIMEOUT_EXEC_MS=90000
KVM_HTTP_TIMEOUT_UPLOAD_MS=120000
KVM_HTTP_RETRIES_META=1
KVM_HTTP_RETRIES_SANDBOX=1
KVM_HTTP_RETRIES_JOB=1
KVM_HTTP_RETRIES_EXEC=1
KVM_HTTP_RETRIES_UPLOAD=1

# ============================================
# OSAC 连接模式
# ============================================
OSAC_CONNECTION_MODE=direct
OSAC_PORT_MAPPING_BASE=20000
OSAC_PORT_MAPPING_RANGE=2000
OSAC_BINARY_PATH=../../others/osac-linux/osac-linux-amd64_v1.1.2.fix2
OPENCODE_BINARY_PATH=../../others/opencode/opencode
OSAC_REMOTE_OSAC_NAME=osac
OSAC_REMOTE_OPENCODE_NAME=opencode
OSAC_CONNECT_RETRIES=6
OSAC_CONNECT_RETRY_DELAY_MS=3000
OSAC_PORT_MAPPING_WAIT_SECONDS=30
OSAC_PORT_MAPPING_CHECKS=4
# 预热池：提前常驻 ready sandbox，减少冷启动导致的抖动
OSAC_WARM_POOL_ENABLED=true
OSAC_WARM_POOL_SIZE=5
OSAC_WARM_POOL_MAX_INFLIGHT=5
OSAC_WARM_POOL_CHECK_INTERVAL_MS=20000
OSAC_WARM_POOL_SCAN_LIMIT=80
OSAC_WARM_POOL_WAIT_READY_MS=10000
OSAC_WARM_POOL_WAIT_POLL_MS=2000
OSAC_WARM_POOL_SEEDING_TTL_MS=180000
OSAC_WARM_POOL_CREATING_TTL_MS=300000
OSAC_WARM_POOL_READY_GATE_ENABLED=true
OSAC_WARM_POOL_READY_GATE_TIMEOUT_MS=60000
OSAC_WARM_POOL_READY_GATE_MODELS_TIMEOUT_MS=90000
OSAC_WARM_POOL_READY_GATE_POLL_MS=1500
OSAC_WARM_POOL_CLEANUP_CLOSE_SESSION=true
OSAC_EXECUTION_ROUNDS=3
OSAC_COMMAND_TIMEOUT_MS=900000
OSAC_COMMAND_POLL_MS=2000
OSAC_PERSISTENT_RECOVER_SKIP_WARM_POOL=true
OSAC_PERSISTENT_RECOVER_MAX_AGE_MS=1800000

# ============================================
# OSAC 配置（配置于 sandbox 内部）
# ============================================
# Upstream model gateway for /api/llm-proxy (no trailing /v1)
LLM_PROXY_UPSTREAM_BASE_URL=http://192.168.10.128:8045
LLM_PROXY_UPSTREAM_API_KEY=replace_with_key
LLM_PROXY_TIMEOUT_MS=60000
LLM_PROXY_RETRIES=2
LLM_PROXY_RETRY_DELAY_MS=250
LLM_PROXY_RETRY_JITTER_MS=120
LLM_PROXY_MAX_SOCKETS=128
LLM_PROXY_MAX_FREE_SOCKETS=32

# OSAC local LLM proxy inside sandbox
OSAC_LLM_PROXY_ENABLE=true
OSAC_LLM_PROXY_PORT=18111
OSAC_OPERATION_CONNECT_ACQUIRE_TIMEOUT_MS=1200
OSAC_LLM_PROXY_BRIDGE_SEND_CONNECT_TIMEOUT_MS=1200
OSAC_LLM_UPSTREAM_BASE_URL=http://192.168.10.128:4000/api/llm-proxy
OSAC_LLM_UPSTREAM_TOKEN=replace_with_secure_token
OSAC_LLM_PROXY_TIMEOUT_MS=60000

# OpenCode uses OSAC local proxy
OPENAI_BASE_URL=http://127.0.0.1:18111/v1
OPENAI_API_KEY=local-proxy
OPENCODE_MODEL=gemini-3-pro-image
