# OneCEO.ai API 环境配置文件 (Windows 版本)
# 请将此文件重命名为 .env 并放在 apps/api 目录下

# ============================================
# 数据库配置
# ============================================
# DATABASE_URL=postgresql://user:password@host:port/database

# ============================================
# 服务器配置
# ============================================
PORT=4000
FRONTEND_URL=http://localhost:3000

# ============================================
# OpenAI API 配置（使用自定义 Claude API）
# ============================================
OPENAI_API_KEY=sk-MRwNM2uHuQSWHohygTJQlWx0jR26xkf20gJJTp8NdRUDLO3c
OPENAI_BASE_URL=https://www.fucheers.top/v1

# ============================================
# 说明
# ============================================
# 1. 将此文件重命名为 .env
# 2. 确保文件位于 apps/api 目录下
# 3. 不要将 .env 文件提交到 Git（已在 .gitignore 中）
# 4. 如需修改配置，请编辑此文件后重启服务

# ============================================
# OSAC 连接模式
# ============================================
OSAC_CONNECTION_MODE=direct
OSAC_PORT_MAPPING_BASE=20000
OSAC_PORT_MAPPING_RANGE=2000
