---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);
---

<BaseLayout
  title="oneceo blog"
  description="Blog content for oneceo."
>
  <section class="card" style="padding: 28px; margin-bottom: 20px;">
    <h1 style="margin: 0 0 10px; font-size: 34px;">oneceo blog</h1>
    <p style="margin: 0; color: var(--muted); font-size: 16px; line-height: 1.7;">
      Separate blog subsite for oneceo.
    </p>
  </section>

  <section class="card" style="padding: 8px 24px;">
    <h2 style="font-size: 18px;">Latest posts</h2>
    <ul style="list-style: none; margin: 0; padding: 0 0 12px;">
      {posts.map((post) => (
        <li style="padding: 18px 0; border-top: 1px solid var(--line);">
          <a href={`/blog/${post.id}/`} style="font-size: 20px; font-weight: 700;">
            {post.data.title}
          </a>
          <p style="margin: 8px 0 0; color: var(--muted);">{post.data.description}</p>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
