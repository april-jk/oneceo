<!-- Archive - Runtime Inspector (Light Theme) -->
<!DOCTYPE html>

<html class="light" lang="en"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&amp;family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<script id="tailwind-config">
      tailwind.config = {
        darkMode: "class",
        theme: {
          extend: {
            colors: {
              "on-tertiary": "#ffffff",
              "inverse-on-surface": "#eaf1ff",
              "surface": "#f8f9ff",
              "surface-container-low": "#eff4ff",
              "on-secondary-container": "#fefcff",
              "primary-fixed": "#8cf6d9",
              "on-secondary": "#ffffff",
              "on-primary-container": "#f4fff9",
              "surface-container-high": "#dde9ff",
              "tertiary-fixed": "#ffddb2",
              "surface-container-lowest": "#ffffff",
              "surface-variant": "#d6e3fb",
              "outline": "#6d7a75",
              "primary-container": "#00846d",
              "tertiary-container": "#9f6a00",
              "on-surface-variant": "#3d4945",
              "surface-container-highest": "#d6e3fb",
              "tertiary-fixed-dim": "#ffb94e",
              "on-primary-fixed-variant": "#005142",
              "surface-container": "#e6eeff",
              "on-secondary-fixed": "#00174b",
              "on-secondary-fixed-variant": "#003ea8",
              "surface-dim": "#cedbf2",
              "secondary-fixed": "#dbe1ff",
              "on-primary-fixed": "#002019",
              "outline-variant": "#bcc9c4",
              "secondary-fixed-dim": "#b4c5ff",
              "inverse-primary": "#6fd9be",
              "on-tertiary-container": "#fffbff",
              "error": "#ba1a1a",
              "surface-tint": "#006b58",
              "error-container": "#ffdad6",
              "inverse-surface": "#243143",
              "on-tertiary-fixed-variant": "#624000",
              "secondary": "#0051d5",
              "surface-bright": "#f8f9ff",
              "on-tertiary-fixed": "#291800",
              "on-error-container": "#93000a",
              "primary": "#006856",
              "background": "#f8f9ff",
              "on-primary": "#ffffff",
              "tertiary": "#7e5300",
              "on-error": "#ffffff",
              "secondary-container": "#316bf3",
              "primary-fixed-dim": "#6fd9be",
              "on-surface": "#0f1c2d",
              "on-background": "#0f1c2d"
            },
            fontFamily: {
              "headline": ["Inter"],
              "body": ["Inter"],
              "label": ["Inter"]
            },
            borderRadius: {"DEFAULT": "0.125rem", "lg": "0.25rem", "xl": "0.5rem", "full": "0.75rem"},
          },
        },
      }
    </script>
<style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
            vertical-align: middle;
        }
        body { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="bg-surface text-on-surface antialiased">
<nav class="bg-white/90 dark:bg-slate-900/90 backdrop-blur-md font-['Inter'] antialiased tracking-tight shadow-sm docked full-width top-0 z-50 border-b border-slate-200 dark:border-slate-800 flex items-center justify-between px-6 h-16 w-full fixed">
<div class="flex items-center gap-8">
<span class="text-xl font-bold text-[#162334] dark:text-slate-100">Runtime Inspector</span>
<div class="hidden md:flex items-center gap-6">
<span class="text-slate-500 dark:text-slate-400 font-medium cursor-pointer hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors px-3 py-1 rounded">System</span>
