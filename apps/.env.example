# OneCEO.ai Unified Environment
# Generated: 2026-03-05T20:00:00
# File: apps/.env.example
# Merge rule: newer file wins on key conflicts.

# ============================================
# Core / Server
# ============================================
PORT=4000
# 前端 origin；GitHub OAuth 本地调试时需要与浏览器实际访问地址完全一致。
# 例如本地 hosts 将 oneceo.ai 指向 127.0.0.1 后，可设为 http://oneceo.ai:3000
FRONTEND_URL=http://localhost:3000
# Public API base used by browser dev tooling allowed-host checks.
ONECEO_API_PUBLIC_URL=http://localhost:3000

# ============================================
# Database
# ============================================
DATABASE_URL=__REDACTED__
DATABASE_SSL=disable

# ============================================
# Redis
# ============================================
# Redis 默认关闭；只有明确设置为 true/1/yes/on 时才启用。
ONECEO_REDIS_ENABLED=false
# 本地 Redis 示例：
# REDIS_URL=redis://127.0.0.1:6379/15
REDIS_URL=

# ============================================
# Frontend (Web) Vite
# ============================================
# 浏览器访问 API 的地址。建议本地 OAuth 调试时与 FRONTEND_URL 使用同一 host，仅端口不同。
VITE_API_BASE_URL=http://127.0.0.1:4000
VITE_ANALYTICS_ENABLED=true
VITE_ANALYTICS_HOST=http://localhost:3000
VITE_ANALYTICS_WEBSITE_ID=dev
VITE_ANALYTICS_TAG=local
VITE_PUBLIC_DOMAIN=localhost
# Extra Vite dev-server allowed hosts, split by comma or whitespace.
# Local ngrok example: WEB_DEV_ALLOWED_HOSTS=.ngrok-free.app
WEB_DEV_ALLOWED_HOSTS=
# Backend target used by the web dev server proxy for /api, /socket.io and /ws/task-creation.
WEB_BFF_API_TARGET=http://localhost:4000

# ============================================
# Connector Secrets
# ============================================
CONNECTOR_SECRET_KEY=
# admin_management -> apps/api 内部接口共享口令
ONECEO_INTERNAL_TOKEN=oneceo-internal-dev-token

# ============================================
# Composio MCP Connectors
# ============================================
COMPOSIO_API_KEY=
# Composio Connect Link callback origin. API appends /{connector}/callback.
# Local examples: http://localhost:3000 or http://oneceo.ai:3000
COMPOSIO_OAUTH_CALLBACK_BASE_URL=

# ============================================
# App Auth / Register Email Verification
# ============================================
# 用户注册邮箱验证码。默认支持 .env 存在时从文件补齐；若 .env 不存在，继续直接读取系统环境变量。
APP_AUTH_SMTP_HOST=smtp.feishu.cn
APP_AUTH_SMTP_PORT=465
APP_AUTH_SMTP_SECURE=true
APP_AUTH_SMTP_USERNAME=
APP_AUTH_SMTP_PASSWORD=
APP_AUTH_SMTP_FROM_EMAIL=
APP_AUTH_SMTP_FROM_NAME=OneCEO
APP_AUTH_REGISTER_CODE_TTL_SECONDS=600
APP_AUTH_REGISTER_CODE_RESEND_COOLDOWN_SECONDS=60

# ============================================
# Umami Analytics (Optional)
# ============================================
UMAMI_ENABLED=false
UMAMI_HOST_URL=
UMAMI_USERNAME=
# 若密码包含 #、空格或其他 shell / dotenv 特殊字符，请加引号。
UMAMI_PASSWORD=""
UMAMI_PLATFORM_TEAM_ID=
UMAMI_DEPLOYMENT_TEAM_ID=

# ============================================
# Managed Deployment / Railway
# ============================================
RAILWAY_ADMIN_TOKEN=
RAILWAY_WORKSPACE_ID=
RAILWAY_DEPLOYMENT_PROJECT_PREFIX=oneceo-user
RAILWAY_DEPLOYMENT_ENVIRONMENT_PREFIX=app
RAILWAY_DEPLOYMENT_SERVICE_NAME=app
RAILWAY_DATABASE_SERVICE_NAME=postgres
RAILWAY_DEPLOYMENT_BUILDER=NIXPACKS
RAILWAY_DEPLOYMENT_BUILD_COMMAND=
RAILWAY_DEPLOYMENT_START_COMMAND=
RAILWAY_DEPLOYMENT_ROOT_DIRECTORY=
RAILWAY_DEPLOYMENT_HEALTHCHECK_PATH=/api/system/health
# Railway service domain 必须指向应用实际监听端口；当前默认模板为 8080。
RAILWAY_DEPLOYMENT_TARGET_PORT=8080
GITHUB_DEPLOYMENT_OWNER=
GITHUB_DEPLOYMENT_APP_ID=
GITHUB_DEPLOYMENT_INSTALLATION_ID=
# 支持两种格式：
# 1. Railway / GitHub Secrets 中推荐使用单行并以 \n 表示换行
# 2. 本地 .env 也可直接使用带真实换行的多行 PEM
GITHUB_DEPLOYMENT_APP_PRIVATE_KEY=
GITHUB_DEPLOYMENT_REPO_PREFIX=oneceo-deploy
GITHUB_DEPLOYMENT_BRANCH=main
GITHUB_DEPLOYMENT_COMMIT_NAME="OneCEO Deploy Bot"
GITHUB_DEPLOYMENT_COMMIT_EMAIL=deploy-bot@oneceo.ai

# ============================================
# Connector OAuth / Vercel (Optional)
# ============================================
# Vercel connector 使用 Vercel Integration 安装授权，Integration URL:
# https://vercel.com/integrations/${VERCEL_INTEGRATION_SLUG}/new
VERCEL_INTEGRATION_SLUG=
VERCEL_INTEGRATION_CLIENT_ID=
VERCEL_INTEGRATION_CLIENT_SECRET=
VERCEL_INTEGRATION_REDIRECT_URI=

# ============================================
# LLM (Agent Orchestration)
# ============================================
OPENAI_API_KEY=__REDACTED__
OPENAI_BASE_URL=https://llmapi.oneceo.ai/v1
OPENAI_API_BASE=https://llmapi.oneceo.ai/v1
LLM_TIMEOUT_MS=90000
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_MS=800
LLM_RETRY_MAX_MS=4000
# 留空时 BaseAgent 默认走本地 /api/llm-proxy/v1
AGENT_OPENAI_API_KEY=__REDACTED__
AGENT_OPENAI_MODEL=claude-haiku-4-5-20251001
ALTUS_MANAGED_MODEL_LITE=claude-haiku-4-5-20251001
ALTUS_MANAGED_MODEL_PRO=claude-haiku-4-5-20251001
ALTUS_MANAGED_MODEL_MAX=claude-haiku-4-5-20251001
ALTUS_MANAGED_BASE_URL_LITE=https://llmapi.oneceo.ai/v1
ALTUS_MANAGED_BASE_URL_PRO=https://llmapi.oneceo.ai/v1
ALTUS_MANAGED_BASE_URL_MAX=https://llmapi.oneceo.ai/v1
ALTUS_MANAGED_API_KEY_LITE=__REDACTED__
ALTUS_MANAGED_API_KEY_PRO=__REDACTED__
ALTUS_MANAGED_API_KEY_MAX=__REDACTED__
ALTUS_MANAGED_API_TYPE_LITE=openai
ALTUS_MANAGED_API_TYPE_PRO=openai
ALTUS_MANAGED_API_TYPE_MAX=openai
ALTUS_MANAGED_VISION_MODEL=qwen3-vl-plus

SANDBOX_ENGINE_OPENCODE_MODEL=gpt-5.3-codex
SANDBOX_ENGINE_OPENCODE_BASE_URL=https://llmapi.oneceo.ai/v1
SANDBOX_ENGINE_OPENCODE_API_KEY=__REDACTED__
SANDBOX_ENGINE_OPENCODE_API_TYPE=openai
SANDBOX_ENGINE_CODEX_MODEL=gpt-5.3-codex
SANDBOX_ENGINE_CODEX_BASE_URL=https://llmapi.oneceo.ai
SANDBOX_ENGINE_CODEX_API_KEY=__REDACTED__
SANDBOX_ENGINE_CODEX_API_TYPE=openai

# ============================================
# LLM Proxy / OpenCode
# ============================================
# 统一 LLM 上游供应商入口
LLM_PROXY_UPSTREAM_BASE_URL=https://llmapi.oneceo.ai
LLM_PROXY_UPSTREAM_API_KEY=__REDACTED__
# 可选: openai / anthropic
LLM_PROXY_UPSTREAM_API_TYPE=anthropic
LLM_PROXY_TIMEOUT_MS=60000
LLM_PROXY_RETRIES=3
LLM_PROXY_RETRY_DELAY_MS=300
OPENCODE_PROVIDER_ID=openai
OPENCODE_BASE_URL=https://llmapi.oneceo.ai/v1
OPENCODE_API_KEY=__REDACTED__
OPENCODE_MODEL=gpt-5.3-codex
OPENCODE_SERVER_HOST=0.0.0.0
OPENCODE_SERVER_PORT=4096
OPENCODE_PROMPT_TIMEOUT_MS=60000
OPENCODE_TASK_WORKSPACE_ROOT=/opt/.altus/opencode/workspaces

# ============================================
# KVM / Orchestrator
# ============================================
KVM_ORCHESTRATOR_URL=http://192.168.10.172:8500
KVM_ORCH_TOKEN=__REDACTED__
KVM_HTTP_TIMEOUT_MS=120000
KVM_HTTP_RETRIES=1
KVM_SANDBOX_BASE_IMAGE=/var/lib/libvirt/images/base-images/ubuntu-22.04-base-v5.qcow2
KVM_SANDBOX_NETWORK=sandbox-net
KVM_SANDBOX_OS_VARIANT=ubuntu22.04
KVM_SANDBOX_MEMORY_MB=2048
KVM_SANDBOX_VCPUS=2

# ============================================
# OSAC / Sandbox Execution
# ============================================
OSAC_BINARY_PATH=../../others/osac-linux/osac-linux-amd64_v1.1.2.fix21
OPENCODE_BINARY_PATH=../../others/opencode/opencode
OSAC_REMOTE_OSAC_NAME=osac
OSAC_REMOTE_OPENCODE_NAME=opencode
OSAC_CONNECTION_MODE=kvm-tcp-relay
OSAC_EXECUTION_ENABLED=true
OSAC_EXECUTION_MODE=opencode_remote
OSAC_EXECUTION_RETRIES=2
OSAC_EXECUTION_ROUNDS=3
OSAC_COMMAND_TIMEOUT_MS=900000
OSAC_COMMAND_POLL_MS=2000
OSAC_COMMAND_IDLE_MS=60000
OSAC_CONNECT_RETRIES=6
OSAC_CONNECT_RETRY_DELAY_MS=3000
OSAC_PORT_MAPPING_WAIT_SECONDS=30
OSAC_PORT_MAPPING_CHECKS=4
OSAC_START_NEW_VM=false
OSAC_USE_FIXED_SANDBOX_SESSION=true
OSAC_FIXED_SANDBOX_SESSION_ID=sess_2268662a2c624117
OSAC_FIXED_SANDBOX_VM_NAME=test_session_manual_use
OSAC_RECONNECT_DELAY_MS=1000
OSAC_RECONNECT_MAX_DELAY_MS=10000
OSAC_RECONNECT_IMMEDIATE_ATTEMPTS=5
OSAC_RECONNECT_MAX_FAILURES=50
OSAC_RECONNECT_GIVEUP_ENABLED=false
OSAC_RECONNECT_ABORT_CODE_THRESHOLD=8
OSAC_PERSISTENT_HEALTHCHECK_MS=3000
OSAC_HEALTHCHECK_MODE=ping
OSAC_HEALTHCHECK_PING_TIMEOUT_MS=5000
OSAC_PERSISTENT_RECOVER_ON_STARTUP=true
OSAC_PERSISTENT_RECOVER_INTERVAL_MS=20000
OSAC_PERSISTENT_RECOVER_SKIP_WARM_POOL=false
OSAC_PERSISTENT_RECOVER_READY_GATE_TIMEOUT_MS=20000
OSAC_PERSISTENT_RECOVER_READY_GATE_ENABLED=true
OSAC_PERSISTENT_RECOVER_MAX_AGE_MS=1800000
OSAC_PERSISTENT_RECOVER_LIMIT=30
OSAC_PROVISION_READY_GATE_POLL_MS=1500
OSAC_PROVISION_READY_GATE_MODELS_TIMEOUT_MS=90000
OSAC_PROVISION_READY_GATE_ENABLED=true
OSAC_PROVISION_READY_GATE_STRICT=true
OSAC_PROVISION_READY_GATE_TIMEOUT_MS=60000
OSAC_WS_PING_INTERVAL=15s
OSAC_WS_IDLE_TIMEOUT=180s
OSAC_INSTANCE_LOCK_PATH=/opt/.altus/opencode/osac.lock
OSAC_WS_AUTH_MODE=header-then-query

# ============================================
# OSAC LLM Proxy (Sandbox)
# ============================================
OSAC_LLM_PROXY_PORT=18111
OSAC_LLM_PROXY_ENABLE=false
OSAC_LLM_PROXY_MAX_INFLIGHT_PER_SESSION=3
OSAC_LLM_PROXY_QUEUE_TIMEOUT_MS=1500
OSAC_LLM_PROXY_STREAM_IDLE_TIMEOUT_MS=45000

# ============================================
# OSAC KVM Relay
# ============================================
OSAC_KVM_RELAY_TARGET_PORT=18080
OSAC_KVM_RELAY_CONNECT_TIMEOUT_MS=5000
OSAC_KVM_RELAY_IDLE_TIMEOUT_MS=180000
OSAC_KVM_RELAY_TICKET_TTL_MS=30000
OSAC_KVM_RELAY_SINGLE_USE=true

# ============================================
# E2B / Archive / Storage
# ============================================
E2B_API_KEY=__REDACTED__
E2B_TIMEOUT_MS=3600000
# 仅用于未经过 API 全局环境初始化、直接加载 e2b-connector 的独立场景。
# apps/api 主进程内的全局 HTTP 代理只看 ONECEO_PROXY_ENABLED。
E2B_PROXY_ENABLED=true
E2B_ARCHIVE_ENABLED=true
E2B_ARCHIVE_JOB_INTERVAL_MS=600000
E2B_ARCHIVE_JOB_ENABLED=true
E2B_ARCHIVE_PRE_TIMEOUT_BUFFER_MS=120000
E2B_ARCHIVE_PENDING_NOTICE_MS=300000
E2B_ARCHIVE_SCAN_LIMIT=500
E2B_ARCHIVE_ON_CLOSE=true
SANDBOX_ACTIVITY_MIN_INTERVAL_MS=30000
SANDBOX_DIRTY_MARK_MIN_INTERVAL_MS=15000
R2_BUCKET_NAME=oneceo-sandbox-storage
R2_ACCOUNT_ID=1db165e7760cc66ac92c02bf6a92102b
R2_ENDPOINT=https://1db165e7760cc66ac92c02bf6a92102b.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=__REDACTED__
R2_SECRET_ACCESS_KEY=__REDACTED__
R2_MANAGED_IMAGE_BUCKET_NAME=oneceo-managed-images-prod
R2_MANAGED_IMAGE_ACCOUNT_ID=1db165e7760cc66ac92c02bf6a92102b
R2_MANAGED_IMAGE_ENDPOINT=https://1db165e7760cc66ac92c02bf6a92102b.r2.cloudflarestorage.com
R2_MANAGED_IMAGE_ACCESS_KEY_ID=__REDACTED__
R2_MANAGED_IMAGE_SECRET_ACCESS_KEY=__REDACTED__
R2_MANAGED_IMAGE_SIGNED_URL_TTL_SECONDS=300

# ============================================
# Network / Proxy
# ============================================
# API 主进程全局 HTTP 出站代理总开关（0/false/no/off to disable）
ONECEO_PROXY_ENABLED=true
HTTP_PROXY=http://127.0.0.1:7897
HTTPS_PROXY=http://127.0.0.1:7897
NO_PROXY=localhost,127.0.0.1,oneceo.ai

# ============================================
# n.eko / Debug
# ============================================
NEKO_WEBRTC_FORCE_MUX=true
NEKO_WEBRTC_TCPMUX=8082
NEKO_WEBRTC_UDPMUX=8083
NEKO_WEBRTC_EPR=0
NEKO_AUTO_NAT1TO1=false
# Cloudflare account-scoped token for creating/reconciling per-user TURN keys.
CLOUDFLARE_TURN_MANAGEMENT_API_TOKEN=__REDACTED__
# Optional explicit account id for TURN key APIs (falls back to R2_ACCOUNT_ID).
CLOUDFLARE_ACCOUNT_ID=1db165e7760cc66ac92c02bf6a92102b
# Optional prefix when creating per-user persistent TURN keys.
CLOUDFLARE_TURN_KEY_PREFIX=oneceo-user-turn
# TURN credential TTL seconds; runtime clamps to 60~172800.
NEKO_TURN_CREDENTIAL_TTL_SECONDS=3600
# 全局默认不强制；调试入口会按业务强制要求 TURN
NEKO_DEBUG_REQUIRE_TURN=false
# JSON 数组；至少包含 1 个 turn/turns server
# 示例: [{"urls":["stun:stun.l.google.com:19302"]},{"urls":["turn:turn.example.com:3478?transport=udp","turns:turn.example.com:5349?transport=tcp"],"username":"user","credential":"pass"}]
NEKO_ICE_SERVERS_JSON=[{"urls":["stun:stun.l.google.com:19302"]}]
