{
  "name": "api",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && esbuild src/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@oneceo/shared": "workspace:*",
    "express": "^4.21.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "zod": "^4.1.12",
    "socket.io": "^4.8.1",
    "bullmq": "^5.36.3",
    "ioredis": "^5.4.2",
    "@prisma/client": "^6.5.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/node": "^24.7.0",
    "typescript": "^5.6.3",
    "tsx": "^4.19.1",
    "esbuild": "^0.25.0",
    "prisma": "^6.5.0"
  }
}
