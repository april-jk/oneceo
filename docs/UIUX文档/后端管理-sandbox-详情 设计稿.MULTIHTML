
<!-- Connectivity - Runtime Inspector (Light Theme) -->
<!DOCTYPE html>

<html lang="en"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>Connectivity | Runtime Inspector</title>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "on-tertiary": "#ffffff",
                        "inverse-on-surface": "#eaf1ff",
                        "surface": "#f8f9ff",
                        "surface-container-low": "#eff4ff",
                        "on-secondary-container": "#fefcff",
                        "primary-fixed": "#8cf6d9",
                        "on-secondary": "#ffffff",
                        "on-primary-container": "#f4fff9",
                        "surface-container-high": "#dde9ff",
                        "tertiary-fixed": "#ffddb2",
                        "surface-container-lowest": "#ffffff",
                        "surface-variant": "#d6e3fb",
                        "outline": "#6d7a75",
                        "primary-container": "#00846d",
                        "tertiary-container": "#9f6a00",
                        "on-surface-variant": "#3d4945",
                        "surface-container-highest": "#d6e3fb",
                        "tertiary-fixed-dim": "#ffb94e",
                        "on-primary-fixed-variant": "#005142",
                        "surface-container": "#e6eeff",
                        "on-secondary-fixed": "#00174b",
                        "on-secondary-fixed-variant": "#003ea8",
                        "surface-dim": "#cedbf2",
                        "secondary-fixed": "#dbe1ff",
                        "on-primary-fixed": "#002019",
                        "outline-variant": "#bcc9c4",
                        "secondary-fixed-dim": "#b4c5ff",
                        "inverse-primary": "#6fd9be",
                        "on-tertiary-container": "#fffbff",
                        "error": "#ba1a1a",
                        "surface-tint": "#006b58",
                        "error-container": "#ffdad6",
                        "inverse-surface": "#243143",
                        "on-tertiary-fixed-variant": "#624000",
                        "secondary": "#0051d5",
                        "surface-bright": "#f8f9ff",
                        "on-tertiary-fixed": "#291800",
                        "on-error-container": "#93000a",
                        "primary": "#006856",
                        "background": "#f8f9ff",
                        "on-primary": "#ffffff",
                        "tertiary": "#7e5300",
                        "on-error": "#ffffff",
                        "secondary-container": "#316bf3",
                        "primary-fixed-dim": "#6fd9be",
                        "on-surface": "#0f1c2d",
                        "on-background": "#0f1c2d"
                    },
                    fontFamily: {
                        "headline": ["Inter"],
                        "body": ["Inter"],
                        "label": ["Inter"]
                    },
                    borderRadius: {"DEFAULT": "0.125rem", "lg": "0.25rem", "xl": "0.5rem", "full": "0.75rem"},
                },
            },
        }
    </script>
<style>
        body { font-family: 'Inter', sans-serif; }
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
        .glass-panel {
            background: rgba(255, 255, 255, 0.92);
            backdrop-filter: blur(12px);
        }
        .primary-gradient {
            background: linear-gradient(135deg, #006856 0%, #00846d 100%);
        }
    </style>
</head>
<body class="bg-surface text-on-surface antialiased">
<!-- TopNavBar -->
<header class="bg-white/90 dark:bg-slate-900/90 backdrop-blur-md font-['Inter'] antialiased tracking-tight shadow-sm docked full-width top-0 z-50 border-b border-slate-200 dark:border-slate-800 flex items-center justify-between px-6 h-16 w-full fixed">
<div class="flex items-center gap-8">
<span class="text-xl font-bold text-[#162334] dark:text-slate-100">Runtime Inspector</span>
<div class="hidden md:flex items-center gap-6">
<span class="text-slate-500 dark:text-slate-400 font-medium cursor-pointer hover:text-[#0f8f77] transition-colors">Nodes</span>
<span class="text-[#0f8f77] font-semibold cursor-pointer">Connectivity</span>
<span class="text-slate-500 dark:text-slate-400 font-medium cursor-pointer hover:text-[#0f8f77] transition-colors">Logs</span>
</div>
</div>
<div class="flex items-center gap-4">
<div class="relative group">
<span class="material-symbols-outlined text-slate-500 group-hover:text-primary cursor-pointer">notifications</span>
</div>
<div class="relative group">
<span class="material-symbols-outlined text-slate-500 group-hover:text-primary cursor-pointer">settings</span>
</div>
<img alt="User Profile Avatar" class="w-8 h-8 rounded-full border border-slate-200" data-alt="Professional user profile portrait headshot" src="https://lh3.googleusercontent.com/aida-public/AB6AXuDAXLRCujv1aX23apj5VGIneCQt-Tr8Zx4OL1DO5P4XM67uceTWszyIQcs9EUWGdmfsB4OjnEQkeEfV755tNLyM5rkkzP277YDs9yc1AHyHs6--_5q4kLURSnHSqdJyq3lmhZ6aKvLwtYjm_FlvcSagbB9F54RpojTxqMbWFpij3-fMMkvq3qOAMCAf8regB8_dnH6tVleI6GEmTKvE5muwlPGzREBoi0beMhAnj5AxiMGx1Ez2Fn5WCm9ZpSgVj6aT2aQ1-GIKJTs"/>
</div>
</header>
<!-- SideNavBar -->
<aside class="bg-[#eff4ff] dark:bg-slate-950 font-['Inter'] text-sm font-medium h-screen w-64 fixed left-0 top-0 pt-20 flex flex-col border-r border-slate-200 dark:border-slate-800 z-40">
<div class="px-6 mb-8">
<div class="flex items-center gap-3">
<div class="w-8 h-8 bg-primary rounded-lg flex items-center justify-center text-white shadow-lg">
<span class="material-symbols-outlined text-[18px]" style="font-variation-settings: 'FILL' 1;">hub</span>
</div>
<div>
<div class="text-lg font-black text-[#162334] dark:text-white leading-tight">Runtime</div>
<div class="text-[10px] text-on-surface-variant/70 uppercase tracking-widest font-bold">v2.4.0-stable</div>
</div>
</div>
</div>
<nav class="flex-1 px-2">
<a class="group flex items-center px-4 py-3 mb-1 text-slate-600 dark:text-slate-400 hover:bg-white/50 dark:hover:bg-slate-800 transition-all duration-200" href="#">
<span class="material-symbols-outlined mr-3">dashboard</span>
                Overview
            </a>
<a class="group flex items-center px-4 py-3 mb-1 bg-white dark:bg-slate-900 text-[#0f8f77] shadow-sm rounded-l-lg ml-2 transition-all duration-200" href="#">
<span class="material-symbols-outlined mr-3" style="font-variation-settings: 'FILL' 1;">hub</span>
                Connectivity
            </a>
<a class="group flex items-center px-4 py-3 mb-1 text-slate-600 dark:text-slate-400 hover:bg-white/50 dark:hover:bg-slate-800 transition-all duration-200" href="#">
<span class="material-symbols-outlined mr-3">archive</span>
                Archive
            </a>
<a class="group flex items-center px-4 py-3 mb-1 text-slate-600 dark:text-slate-400 hover:bg-white/50 dark:hover:bg-slate-800 transition-all duration-200" href="#">
<span class="material-symbols-outlined mr-3">monitoring</span>
                Metrics
            </a>
<a class="group flex items-center px-4 py-3 mb-1 text-slate-600 dark:text-slate-400 hover:bg-white/50 dark:hover:bg-slate-800 transition-all duration-200" href="#">
<span class="material-symbols-outlined mr-3">settings_input_component</span>
                Advanced
            </a>
</nav>
<div class="mt-auto p-4 m-4 rounded-xl bg-primary/5 border border-primary/10">
<div class="text-[11px] font-bold text-primary uppercase tracking-wider mb-2">System Load</div>
<div class="w-full bg-slate-200 h-1.5 rounded-full overflow-hidden">
<div class="bg-primary h-full w-[42%]"></div>
</div>
<div class="flex justify-between mt-2 text-[10px] text-on-surface-variant font-medium">
<span>42.8% Capacity</span>
<span>Normal</span>
</div>
</div>
</aside>
<!-- Main Content -->
<main class="ml-64 pt-24 p-8 min-h-screen">
<div class="max-w-6xl mx-auto">
<div class="flex items-center justify-between mb-8">
<div>
<h1 class="text-2xl font-bold tracking-tight text-on-surface">Network Connectivity</h1>
<p class="text-on-surface-variant text-sm mt-1">Real-time inspection of distributed node protocols and handshake status.</p>
</div>
<button class="primary-gradient text-white px-5 py-2.5 rounded shadow-sm hover:opacity-90 active:opacity-100 flex items-center gap-2 text-sm font-semibold transition-all">
<span class="material-symbols-outlined text-[18px]">bolt</span>
                    Run Connectivity Check
                </button>
</div>
<!-- Connectivity Bento Grid -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
<!-- Status Card: OSAC -->
<div class="glass-panel p-6 rounded-xl border-l-4 border-[#0c705d] shadow-[0_4px_20px_rgba(0,0,0,0.02)]">
<div class="flex items-start justify-between mb-4">
<div class="p-2 rounded bg-[#0f8f79]/10 text-[#0c705d]">
<span class="material-symbols-outlined">security</span>
</div>
<div class="bg-[#0f8f79]/10 text-[#0c705d] text-[10px] font-bold px-2 py-1 rounded uppercase tracking-wider">Active</div>
</div>
<div class="text-sm font-medium text-on-surface-variant mb-1">OSAC Protocol</div>
<div class="text-2xl font-bold text-on-surface tracking-tight">Handshake: OK</div>
<div class="mt-4 flex items-center text-[11px] text-[#0c705d] font-semibold gap-1">
<span class="material-symbols-outlined text-[14px]">check_circle</span>
                        Latency: 14ms
                    </div>
</div>
<!-- Status Card: OpenCode -->
<div class="glass-panel p-6 rounded-xl border-l-4 border-[#0c705d] shadow-[0_4px_20px_rgba(0,0,0,0.02)]">
<div class="flex items-start justify-between mb-4">
<div class="p-2 rounded bg-[#0f8f79]/10 text-[#0c705d]">
<span class="material-symbols-outlined">sync</span>
</div>
<div class="bg-[#0f8f79]/10 text-[#0c705d] text-[10px] font-bold px-2 py-1 rounded uppercase tracking-wider">Synchronized</div>
</div>
<div class="text-sm font-medium text-on-surface-variant mb-1">OpenCode Sync</div>
<div class="text-2xl font-bold text-on-surface tracking-tight">V3 Registry</div>
<div class="mt-4 flex items-center text-[11px] text-[#0c705d] font-semibold gap-1">
<span class="material-symbols-outlined text-[14px]">update</span>
                        Last sync 2m ago
                    </div>
</div>
<!-- Status Card: Traffic Token -->
<div class="glass-panel p-6 rounded-xl border-l-4 border-[#c98916] shadow-[0_4px_20px_rgba(0,0,0,0.02)]">
<div class="flex items-start justify-between mb-4">
<div class="p-2 rounded bg-[#c98916]/10 text-[#c98916]">
<span class="material-symbols-outlined">vpn_key</span>
</div>
<div class="bg-[#c98916]/10 text-[#c98916] text-[10px] font-bold px-2 py-1 rounded uppercase tracking-wider">Expiring Soon</div>
</div>
<div class="text-sm font-medium text-on-surface-variant mb-1">Traffic Token</div>
<div class="text-2xl font-bold text-on-surface tracking-tight">TTL: 42:15</div>
<div class="mt-4 flex items-center text-[11px] text-[#c98916] font-semibold gap-1">
<span class="material-symbols-outlined text-[14px]">warning</span>
                        Requires rotation in &lt; 1h
                    </div>
</div>
</div>
<div class="grid grid-cols-1 lg:grid-cols-5 gap-6">
<!-- Configuration Details (Asymmetric Layout) -->
<div class="lg:col-span-3 glass-panel rounded-xl overflow-hidden shadow-[0_4px_20px_rgba(0,0,0,0.02)]">
<div class="bg-surface-container-low px-6 py-4 flex items-center justify-between border-b border-outline-variant/10">
<h3 class="text-sm font-bold text-on-surface uppercase tracking-wider">Configuration Endpoint Map</h3>
<span class="text-[10px] font-medium text-on-surface-variant bg-white px-2 py-1 rounded">Read-Only</span>
</div>
<div class="p-6 space-y-6">
<div class="flex flex-col gap-1.5">
<label class="text-[11px] font-bold text-on-surface-variant uppercase tracking-wide">osacEndpoint</label>
<div class="bg-surface rounded p-3 flex items-center justify-between group border border-transparent hover:border-primary/20 transition-all">
<code class="text-sm text-primary font-mono truncate mr-4">wss://relay-prod.runtime-observer.io:8443</code>
<span class="material-symbols-outlined text-outline-variant text-[18px] cursor-pointer hover:text-primary transition-colors">content_copy</span>
</div>
</div>
<div class="flex flex-col gap-1.5">
<label class="text-[11px] font-bold text-on-surface-variant uppercase tracking-wide">opencodeBaseUrl</label>
<div class="bg-surface rounded p-3 flex items-center justify-between group border border-transparent hover:border-primary/20 transition-all">
<code class="text-sm text-on-surface font-mono truncate mr-4">https://api.opencode.dev/v3/registry</code>
<span class="material-symbols-outlined text-outline-variant text-[18px] cursor-pointer hover:text-primary transition-colors">content_copy</span>
</div>
</div>
<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
<div class="flex flex-col gap-1.5">
<label class="text-[11px] font-bold text-on-surface-variant uppercase tracking-wide">workspaceRoot</label>
<div class="bg-surface rounded p-3 flex items-center justify-between group border border-transparent hover:border-primary/20 transition-all">
<code class="text-[13px] text-on-surface font-mono truncate">/vol/data/observer/node_01/runtime</code>
</div>
</div>
<div class="flex flex-col gap-1.5">
<label class="text-[11px] font-bold text-on-surface-variant uppercase tracking-wide">stateRoot</label>
<div class="bg-surface rounded p-3 flex items-center justify-between group border border-transparent hover:border-primary/20 transition-all">
<code class="text-[13px] text-on-surface font-mono truncate">0x8a92f...cd12</code>
</div>
</div>
</div>
</div>
</div>
<!-- Connectivity Check Log -->
<div class="lg:col-span-2 glass-panel rounded-xl flex flex-col shadow-[0_4px_20px_rgba(0,0,0,0.02)]">
<div class="bg-surface-container-low px-6 py-4 border-b border-outline-variant/10">
<h3 class="text-sm font-bold text-on-surface uppercase tracking-wider">Check Result Log</h3>
</div>
<div class="flex-1 p-6 font-mono text-[12px] overflow-auto max-h-[400px]">
<div class="space-y-3">
<div class="flex gap-3">
<span class="text-outline-variant">[14:22:01]</span>
<span class="text-primary font-bold">INFO</span>
<span class="text-on-surface">Initiating global diagnostic sweep...</span>
</div>
<div class="flex gap-3">
<span class="text-outline-variant">[14:22:02]</span>
<span class="text-primary font-bold">INFO</span>
<span class="text-on-surface">OSAC handshake verified (14ms)</span>
</div>
<div class="flex gap-3">
<span class="text-outline-variant">[14:22:03]</span>
<span class="text-[#c98916] font-bold">WARN</span>
<span class="text-on-surface">Traffic Token rotation required in 42m</span>
</div>
<div class="flex gap-3">
<span class="text-outline-variant">[14:22:03]</span>
<span class="text-primary font-bold">INFO</span>
<span class="text-on-surface">OpenCode registry fetch complete.</span>
</div>
<div class="flex gap-3">
<span class="text-outline-variant">[14:22:04]</span>
<span class="text-[#0c705d] font-bold">DONE</span>
<span class="text-[#0c705d]">All critical systems operational.</span>
</div>
<div class="pt-4 border-t border-slate-100 flex items-center gap-2 text-on-surface-variant">
<span class="material-symbols-outlined text-[16px]">history</span>
<span>Session duration: 4h 12m</span>
</div>
</div>
</div>
<div class="p-4 bg-slate-50/50 flex justify-end">
<button class="text-[11px] font-bold text-primary uppercase tracking-widest hover:underline px-2 py-1">Export Results</button>
</div>
</div>
</div>
<!-- Footer Meta -->
<footer class="mt-12 pt-6 border-t border-slate-200 flex flex-wrap gap-8 justify-between text-on-surface-variant">
<div class="flex gap-6">
<div class="flex flex-col gap-1">
<span class="text-[10px] font-bold uppercase tracking-widest text-outline-variant">Runtime Node</span>
<span class="text-xs font-semibold text-on-surface">obs-primary-us-east</span>
</div>
<div class="flex flex-col gap-1">
<span class="text-[10px] font-bold uppercase tracking-widest text-outline-variant">Active Peer Count</span>
<span class="text-xs font-semibold text-on-surface">1,244 Nodes</span>
</div>
</div>
<div class="flex items-center gap-4">
<div class="flex items-center gap-2">
<div class="w-2 h-2 rounded-full bg-[#0c705d] animate-pulse"></div>
<span class="text-xs font-medium">Real-time Data Stream: Enabled</span>
</div>
</div>
</footer>
</div>
</main>
</body></html>

<!-- Metrics - Runtime Inspector (Light Theme) -->
<!DOCTYPE html>

<html lang="en"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>Runtime Inspector - Metrics</title>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "on-tertiary": "#ffffff",
                        "inverse-on-surface": "#eaf1ff",
                        "surface": "#f8f9ff",
                        "surface-container-low": "#eff4ff",
                        "on-secondary-container": "#fefcff",
                        "primary-fixed": "#8cf6d9",
                        "on-secondary": "#ffffff",
                        "on-primary-container": "#f4fff9",
                        "surface-container-high": "#dde9ff",
                        "tertiary-fixed": "#ffddb2",
                        "surface-container-lowest": "#ffffff",
                        "surface-variant": "#d6e3fb",
                        "outline": "#6d7a75",
                        "primary-container": "#00846d",
                        "tertiary-container": "#9f6a00",
                        "on-surface-variant": "#3d4945",
                        "surface-container-highest": "#d6e3fb",
                        "tertiary-fixed-dim": "#ffb94e",
                        "on-primary-fixed-variant": "#005142",
                        "surface-container": "#e6eeff",
                        "on-secondary-fixed": "#00174b",
                        "on-secondary-fixed-variant": "#003ea8",
                        "surface-dim": "#cedbf2",
                        "secondary-fixed": "#dbe1ff",
                        "on-primary-fixed": "#002019",
                        "outline-variant": "#bcc9c4",
                        "secondary-fixed-dim": "#b4c5ff",
                        "inverse-primary": "#6fd9be",
                        "on-tertiary-container": "#fffbff",
                        "error": "#ba1a1a",
                        "surface-tint": "#006b58",
                        "error-container": "#ffdad6",
                        "inverse-surface": "#243143",
                        "on-tertiary-fixed-variant": "#624000",
                        "secondary": "#0051d5",
                        "surface-bright": "#f8f9ff",
                        "on-tertiary-fixed": "#291800",
                        "on-error-container": "#93000a",
                        "primary": "#006856",
                        "background": "#f8f9ff",
                        "on-primary": "#ffffff",
                        "tertiary": "#7e5300",
                        "on-error": "#ffffff",
                        "secondary-container": "#316bf3",
                        "primary-fixed-dim": "#6fd9be",
                        "on-surface": "#011c2d",
                        "on-background": "#0f1c2d"
                    },
                    fontFamily: {
                        "headline": ["Inter"],
                        "body": ["Inter"],
                        "label": ["Inter"]
                    },
                    borderRadius: {"DEFAULT": "0.125rem", "lg": "0.25rem", "xl": "0.5rem", "full": "0.75rem"},
                },
            },
        }
    </script>
<style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
        .chart-gradient-primary { background: linear-gradient(180deg, rgba(15, 143, 119, 0.1) 0%, rgba(15, 143, 119, 0) 100%); }
        .chart-gradient-secondary { background: linear-gradient(180deg, rgba(37, 99, 235, 0.1) 0%, rgba(37, 99, 235, 0) 100%); }
        .chart-gradient-warning { background: linear-gradient(180deg, rgba(201, 137, 22, 0.1) 0%, rgba(201, 137, 22, 0) 100%); }
    </style>
</head>
<body class="bg-surface font-body text-on-surface antialiased">
<!-- TopNavBar -->
<header class="bg-white/90 dark:bg-slate-900/90 backdrop-blur-md font-['Inter'] antialiased tracking-tight shadow-sm border-b border-slate-200 dark:border-slate-800 docked full-width top-0 z-50 fixed w-full">
<div class="flex items-center justify-between px-6 h-16 w-full">
<div class="flex items-center gap-8">
<span class="text-xl font-bold text-[#162334] dark:text-slate-100">Runtime Inspector</span>
<div class="hidden md:flex items-center bg-surface-container-low px-3 py-1.5 rounded-lg border border-outline-variant/20">
<span class="material-symbols-outlined text-on-surface-variant text-sm mr-2">search</span>
<input class="bg-transparent border-none focus:ring-0 text-sm w-64 p-0" placeholder="Search resources..." type="text"/>
</div>
</div>
<div class="flex items-center gap-4">
<button class="p-2 hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors cursor-pointer active:opacity-80 rounded-full">
<span class="material-symbols-outlined text-slate-500">notifications</span>
</button>
<button class="p-2 hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors cursor-pointer active:opacity-80 rounded-full">
<span class="material-symbols-outlined text-slate-500">settings</span>
</button>
<div class="h-8 w-8 rounded-full bg-primary-container flex items-center justify-center text-white overflow-hidden ml-2">
<img alt="User Profile Avatar" data-alt="Close up professional male headshot avatar" src="https://lh3.googleusercontent.com/aida-public/AB6AXuDpwZuOkGcjlhmZM62bH6kX39vWJ_-XY9i1xmZ20VSvrvrOIekIn8YEr0sms8PSAr_BwI42gZLYMSSJl4gqwqFS8vihbs1HlpIb5eMqUCRDxhECl5uc-JxCLnZfgDoV2p3Suky0Q0eaik1oOtBCVbTnBYSwg94U_CKHXYHuYIfzghkfX4yTuDhc6HHYwLaslRzBtPDL0aR600HyWoOg_H9HGjeKOwpqe0nwm-iJpP6XnfC_sNC9wDm-JPrrrM5ZpcYMLTZbiixvp2A"/>
</div>
</div>
</div>
</header>
<div class="flex min-h-screen">
<!-- SideNavBar -->
